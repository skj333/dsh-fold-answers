{
  "name": "dsh-fold-answers",
  "version": "0.2.0",
  "type": "module",
  "description": "Fold individual assistant answers and per-turn feature cards in the DeepSeek Harness chat transcript; display-only, the session log and model context are untouched.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "chat",
    "fold",
    "collapse",
    "transcript"
  ],
  "license": "MIT",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "INSTALL.md"
  ],
  "engines": {
    "dsh": ">=0.2.2-rc.5"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-chat"]
    }
  }
}
